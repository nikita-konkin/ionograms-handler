# The recorder. Every setting below was paid for by an incident.
[Unit]
Description=chirpsounder2 recorder (USRP -> Digital RF)
PartOf=chirp.target
Before=chirp-detect.service chirp-ionograms.service

# The recorder copies the host clock into the USRP epoch verbatim
# (rx_uhd_ext_gps.cpp:433 sets time from pc_secs, never from the GPSDO's
# gps_time sensor), so starting before NTP has stepped the clock stamps every
# sample with whatever the RTC happened to hold. On 2026-08-06 that was
# 2021-04-02. This ordering is the whole fix on our side; see health.system_clock
# for the detection, since ordering cannot help if NTP itself never converges.
Wants=time-sync.target
After=time-sync.target

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/chirpsounder2

# The NIC RX ring resets to 256 on every boot. At 25 MS/s over 1 GbE that is
# ~68,000 packets/second into a ring sized for a tenth of it, and the recorder
# drops data continuously. Jumbo frames are NOT an option: the N2x0 probes at
# 1472 bytes whatever the host MTU.
# PermissionsStartOnly, not the `+` prefix. `+` needs systemd 231 and DOB runs
# 229 (Ubuntu 16.04), where an ExecStart path beginning with `+` is not a
# prefix at all -- it is a path that is not absolute, so the unit fails to load
# and the recorder never starts. This unit had that bug from the day it was
# written; it was never caught because nothing has installed it yet.
PermissionsStartOnly=true
#
# **`ethtool -G` exits 80 when the ring is already the size you asked for**,
# printing `no ring parameters changed, aborting`. So the first start of this
# unit succeeds, sets the ring 256 -> 4096, and thereby guarantees that every
# later start fails in `ExecStartPre` and never reaches the recorder at all.
# Observed on the station 2026-08-16: one clean start at 12:55 that streamed,
# then `Control process exited, code=exited status=80` every ten seconds
# forever. The unit's own success is what breaks it, which is why the fault
# only appears on the *second* start -- i.e. on the restart path, i.e. on the
# console button this whole migration exists to make work.
#
# `-` on the line would hide a genuinely wrong interface name too, and that one
# is silent and expensive: the ring stays at 256 and the recorder drops up to
# 45% of its samples while everything reports healthy. So exit 80 is accepted
# by name and every other failure still stops the start.
ExecStartPre=/bin/sh -c '/sbin/ethtool -G enp0s25 rx 4096; case $? in 0|80) exit 0;; *) exit 1;; esac'
ExecStartPre=/sbin/sysctl -w net.core.rmem_max=500000000
#
# The recorder runs as `ionouser`; these two lines run as **root**, because
# `PermissionsStartOnly` is per-unit and not per-line. A bare `mkdir -p` here
# therefore creates a root-owned directory that the recorder cannot write into
# -- it fails at `mkdir -p /dev/shm/hf25/ch0` with EACCES, which reads as a
# recorder bug and is not one. It has never bitten because the directory
# already existed, owned by `ionouser`, from `dombas.sh`; the first start after
# `/dev/shm/hf25` is cleared by hand is the one that finds out. Same shape, and
# the same fix, as `/var/lib/chirp-drop-watch` in chirp-drop-watch.service.
ExecStartPre=/bin/mkdir -p /dev/shm/hf25
ExecStartPre=/bin/chown ionouser:ionouser /dev/shm/hf25

# The ringbuffer's *contents* belong to the recorder, so they die with it.
# Upstream's `dombas.sh` clears them once at script start but its restart loop
# only re-execs the recorder -- so a run that ended with the pruner dead leaves
# a full tmpfs, and the next start dies at sample 0 with ENOSPC
# ("dataset_samples_written = 0", 2026-08-06). Reclaiming on *stop* rather than
# on start is deliberate: a start-time rm would delete data the consumers are
# still reading during an in-place restart. A tmpfs filling while the recorder
# runs is a different fault -- a dead pruner -- and belongs to
# `ringbuffer_free_fraction`, not here.
#
# **The directory itself must survive, and this line used to remove it.** With
# `Restart=always` below, the every-24-h exit is now an automatic restart, and
# `chirp-ringbuffer.service` does not follow the recorder through one -- it is
# only `After=`, with no `BindsTo=`, so it stays up. `drf ringbuffer` watches a
# path; delete the path and the pruner spends the next 24 h holding a watch on
# an unlinked inode while `ExecStartPre` builds a fresh directory nothing
# prunes. That is precisely the two-days-of-soundings failure the pruner exists
# to prevent, rearmed to fire once a day. Observed as the ancestor of this
# arrangement: under `dombas.sh` the directory persisted across every 24 h
# rotation and one long-lived pruner kept working, which is the configuration
# with field evidence behind it.
#
# The glob leaves the directory and its ownership in place. It does not match
# dotfiles; Digital RF writes none.
ExecStopPost=-/bin/sh -c 'rm -rf /dev/shm/hf25/*'

# Real-time priority for the receive thread, granted by systemd rather than by
# limits.conf (which does nothing without pam_limits.so in common-session --
# it was absent here) or by setcap (which any rebuild of the binary clears).
LimitRTPRIO=99
LimitMEMLOCK=infinity

# Physical core 0 is the recorder's, and nobody else's. **That is CPUs 0 and 1,
# not CPU 0.** DOB is an i7-4930MX -- four cores, eight threads -- and
# /sys/devices/system/cpu/cpu0/topology/thread_siblings_list reads `0-1`. The
# consumers are held off both by CPUAffinity=2-7 in chirp-detect.service and
# chirp-ionograms.service; that exclusion is half of this setting and is worth
# nothing without it.
#
# The recorder was one of twelve processes queueing for four cores and lost up
# to 45% of its samples to the wait -- at load 9.4, with CPU still idle, because
# the fault is scheduling latency and not throughput. It needs about 0.8 of a
# core, but it needs it the instant a packet arrives. Measured on 2026-08-12:
# 358,691 drops per 900 s unpinned, 0 drops and a frozen RcvbufErrors counter
# pinned.
#
# **The first version of this said CPUAffinity=0 with the consumers on 1-7, and
# that is half a fix.** An MPI rank on cpu1 shares this core's execution units,
# L1 and L2; the recorder had a dedicated hyperthread, not a dedicated core.
# What it cost is in docs/2026-08-11-recorder-packet-loss.md sec. 7: clean at
# night when the sibling idles, ~3.4% of the stream lost through the morning
# when it does not, and no correlation with load average either way.
#
# Both siblings rather than cpu0 alone: they share L1 and L2, so a thread
# moving between them costs nothing, and leaving cpu1 empty would only deny the
# recorder's own helper threads a place to run.
CPUAffinity=0-1

# CPU 7 stays in the consumers' pool. Every NIC interrupt lands there -- one
# queue, 2.2 billion on that thread over six days -- and on a four-core part
# fencing off a whole physical core for a softirq doing ~3,750 interrupts/s is
# not affordable. Revisit only if the counters implicate it directly.

# **The LO is not compiled in any more, and this line is why.** It used to exec
# the recorder directly, which left the tuned frequency in two places -- the
# `set_rx_freq` built into the binary and `center_freq` in my_station.ini --
# with nothing keeping them equal. calc_ionograms builds its downconversion
# mixer from the ini key while the samples come from wherever the recorder
# tuned; nothing checks the two and nothing can, because the LO is not written
# into the Digital RF metadata. A mismatch dechirps by the difference and
# yields empty products with **no error in any log**. It blinded this station
# twice on 2026-08-19 -- once from an ini applied before the rebuild, once from
# a source edit that was never rebuilt at all.
#
# The wrapper reads the ini and passes `--center-freq`, so the ini is the only
# place the number lives. It requires patch 0014 in the recorder; against an
# older binary boost::program_options rejects the unknown option and the unit
# fails loudly, which is the correct outcome and not a bug to work around.
#
# The wrapper ends in `exec`, so the recorder is still MAINPID and KillSignal
# below still reaches it. That property is load-bearing -- see the SIGINT note.
ExecStart=/home/ionouser/ionograms-handler/tools/chirp-rx-launch.sh

# THE important line. A USRP killed mid-stream keeps transmitting UDP to a host
# that is gone: it stops answering ARP and discovery, and nothing on the host
# recovers it -- only removing power, which is a site visit. UHD's handler
# sends the stop-streaming command on SIGINT and on nothing else.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30

# The line above protects the USRP from systemd. This one protects it from the
# kernel, which is the same site visit by a different route: the OOM killer
# sends SIGKILL directly and KillSignal has no say in it, so the radio is left
# transmitting exactly as if someone had run `kill -9`.
#
# That is not hypothetical here. The ringbuffer is 13 G of tmpfs, and tmpfs
# pages are shared, not reclaimable -- Linux excludes them from `available`,
# which on 2026-08-12 read 1.6 G of 31 G with 5.4 G already swapped. The
# recorder is also the fattest RSS on the box, i.e. exactly what the OOM killer
# looks for. Growing the ringbuffer makes both facts worse, so this setting is
# a precondition for raising the size, not an afterthought to it.
#
# -1000 requires CAP_SYS_RESOURCE, which is why `dombas.sh` cannot set it and
# why doing it by hand lapses at the recorder's next 24-hour restart. Prefer
# losing an ionogram consumer to losing the radio.
OOMScoreAdjust=-1000

# **`always`, not `on-failure`. The recorder's normal end of life is exit 0.**
# `rx_uhd_ext_gps` streams for 24 hours and then stops on purpose, logging
# `Channel 0 finished 24h streaming.` -- that is where `dombas.sh`'s `while
# true` loop came from, and BACKLOG sec. 23 is wrong to call it "no 24-hour
# timer in that loop": the timer is in the C++ program and the loop is what
# catches it.
#
# This unit was migrated with `on-failure`, which by definition declines to
# restart a success. So the station recorded for exactly 24 h after each start
# and then stopped for good, leaving no failure anywhere to look at: the unit
# reads `inactive (dead)`, not `failed`, `systemctl status` shows
# `status=0/SUCCESS`, and the only alarm is `newest_product_age_s` half an hour
# later. Yoshkar-Ola, 2026-08-17: started 16:52:53 MSK on the 16th, exited
# 16:52:58 MSK on the 17th, 24 h and 5 s, and stayed down.
#
# `always` does not defeat the console's stop button. systemd auto-restarts on
# a unit *exiting*, never after a `systemctl stop` job -- so a deliberate stop
# still stops, which is the property the USRP's SIGINT handling depends on.
Restart=always
RestartSec=10

[Install]
WantedBy=chirp.target
