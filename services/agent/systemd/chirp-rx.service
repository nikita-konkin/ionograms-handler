# The recorder. Every setting below was paid for by an incident.
[Unit]
Description=chirpsounder2 recorder (USRP -> Digital RF)
PartOf=chirp.target
Before=chirp-detect.service chirp-ionograms.service

# The recorder copies the host clock into the USRP epoch verbatim
# (rx_uhd_ext_gps.cpp:433 sets time from pc_secs, never from the GPSDO's
# gps_time sensor), so starting before NTP has stepped the clock stamps every
# sample with whatever the RTC happened to hold. On 2026-08-06 that was
# 2021-04-02. This ordering is the whole fix on our side; see health.system_clock
# for the detection, since ordering cannot help if NTP itself never converges.
Wants=time-sync.target
After=time-sync.target

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/chirpsounder2

# The NIC RX ring resets to 256 on every boot. At 25 MS/s over 1 GbE that is
# ~68,000 packets/second into a ring sized for a tenth of it, and the recorder
# drops data continuously. Jumbo frames are NOT an option: the N2x0 probes at
# 1472 bytes whatever the host MTU.
ExecStartPre=+/sbin/ethtool -G enp0s25 rx 4096
ExecStartPre=+/sbin/sysctl -w net.core.rmem_max=500000000
ExecStartPre=/bin/mkdir -p /dev/shm/hf25

# The ringbuffer belongs to the recorder, so it dies with it. Upstream's
# `dombas.sh` clears it once at script start but its 24-hour restart loop only
# re-execs the recorder -- so a run that ended with the pruner dead leaves a
# full tmpfs, and the next start dies at sample 0 with ENOSPC
# ("dataset_samples_written = 0", 2026-08-06). Reclaiming on *stop* rather than
# on start is deliberate: a start-time rm would delete data the consumers are
# still reading during an in-place restart. A tmpfs filling while the recorder
# runs is a different fault -- a dead pruner -- and belongs to
# `ringbuffer_free_fraction`, not here.
ExecStopPost=-/bin/rm -rf /dev/shm/hf25

# Real-time priority for the receive thread, granted by systemd rather than by
# limits.conf (which does nothing without pam_limits.so in common-session --
# it was absent here) or by setcap (which any rebuild of the binary clears).
LimitRTPRIO=99
LimitMEMLOCK=infinity

# Core 0 is the recorder's, and nobody else's. The consumers are held off it by
# CPUAffinity=1-7 in chirp-detect.service and chirp-ionograms.service; that
# exclusion is half of this setting and is worth nothing without it.
#
# The recorder was one of twelve processes queueing for eight cores and lost up
# to 45% of its samples to the wait -- at load 9.4, with CPU still idle, because
# the fault is scheduling latency and not throughput. It needs about 0.8 of a
# core, but it needs it the instant a packet arrives. Measured on 2026-08-12:
# 358,691 drops per 900 s unpinned, 0 drops and a frozen RcvbufErrors counter
# pinned. Core 7 is deliberately left in the consumers' pool -- every NIC
# interrupt lands there, so isolating it would move the softirq, not protect it.
CPUAffinity=0

ExecStart=/home/ionouser/chirpsounder2/rx_uhd_ext_gps \
    --outdir=/dev/shm/hf25 \
    --usrp_args=addr0=192.168.10.2,recv_buff_size=500000000

# THE important line. A USRP killed mid-stream keeps transmitting UDP to a host
# that is gone: it stops answering ARP and discovery, and nothing on the host
# recovers it -- only removing power, which is a site visit. UHD's handler
# sends the stop-streaming command on SIGINT and on nothing else.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=30

# The line above protects the USRP from systemd. This one protects it from the
# kernel, which is the same site visit by a different route: the OOM killer
# sends SIGKILL directly and KillSignal has no say in it, so the radio is left
# transmitting exactly as if someone had run `kill -9`.
#
# That is not hypothetical here. The ringbuffer is 13 G of tmpfs, and tmpfs
# pages are shared, not reclaimable -- Linux excludes them from `available`,
# which on 2026-08-12 read 1.6 G of 31 G with 5.4 G already swapped. The
# recorder is also the fattest RSS on the box, i.e. exactly what the OOM killer
# looks for. Growing the ringbuffer makes both facts worse, so this setting is
# a precondition for raising the size, not an afterthought to it.
#
# -1000 requires CAP_SYS_RESOURCE, which is why `dombas.sh` cannot set it and
# why doing it by hand lapses at the recorder's next 24-hour restart. Prefer
# losing an ionogram consumer to losing the radio.
OOMScoreAdjust=-1000

Restart=on-failure
RestartSec=10

[Install]
WantedBy=chirp.target
