[Unit]
Description=chirpsounder2 detect_chirps.py
PartOf=chirp.target
Requires=chirp-rx.service
After=chirp-rx.service

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/chirpsounder2

# Stay off physical core 0, which is CPUs 0 AND 1. See chirp-rx.service: the
# recorder owns that core and needs it the instant a packet arrives, and this
# unit is one of the processes that was crowding it. `taskset` in a launcher
# script achieves the same thing by inheritance, but only for children of that
# one script.
#
# 2-7, not 1-7. DOB is an i7-4930MX: four physical cores, eight threads, with
# `cpu0`'s sibling being `cpu1` (thread_siblings_list = 0-1). A rank on cpu1
# shares the recorder's execution units, L1 and L2 -- it is the same core. The
# first version of this said 1-7 and left the recorder with half a core it
# believed it owned outright.
CPUAffinity=2-7

# Ranks here are plain parallelism -- any count is valid, unlike
# chirp-ionograms.service, where -np is pinned to the schedule.
#
# **--bind-to none, or CPUAffinity above is decoration.** Open MPI calls
# sched_setaffinity on each rank after fork, overwriting whatever it inherited,
# and 1.10 (what Ubuntu 16.04 ships) defaults to --bind-to core for -np <= 2.
# It then places rank 0 on physical core 0 by machine topology -- CPUs 0 and 1,
# the recorder's -- with no reference to the mask it was started under.
# Measured on DOB 2026-08-13, under a launcher already tasksetted to 2-7:
# mpirun itself read 2-7 while its two ranks read 0,1 and 2,3. This flag makes
# the ranks inherit instead, at the cost of core-level cache locality.
ExecStart=/usr/bin/mpirun --bind-to none -np 2 /home/ionouser/chirpsounder2/.venv38/bin/python3 detect_chirps.py --config /home/ionouser/chirpsounder2/my_station.ini
Restart=always
RestartSec=15

[Install]
WantedBy=chirp.target
