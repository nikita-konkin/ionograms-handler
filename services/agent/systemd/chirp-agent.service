# The agent itself. Deliberately NOT PartOf=chirp.target: it must survive a
# stop of acquisition, or "stop sounding" would be the last command the server
# could ever issue.
[Unit]
Description=ionograms-handler station agent
After=network-online.target

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/ionograms-handler
Environment=AGENT_CONFIG=/home/ionouser/ionograms-handler/agent.json
# The shared secret, and nothing else. agent.json gets scp'd, edited and backed
# up; a token in it spreads with every copy. This file is root-owned 0600 and
# stays on the machine:
#
#   printf 'AGENT_TOKEN=%s\n' "$CONTROL_TOKEN" | sudo tee /etc/default/chirp-agent
#   sudo chmod 600 /etc/default/chirp-agent
#
# The leading `-` makes it optional, so a station that has not been given a
# token yet still starts -- it reports to stdout and accepts no commands, which
# is the honest behaviour for an agent with no credential.
EnvironmentFile=-/etc/default/chirp-agent
ExecStart=/usr/bin/python3 -m services.agent run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
