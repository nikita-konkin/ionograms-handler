# The pruner. Its absence cost two days of soundings.
[Unit]
Description=chirpsounder2 ringbuffer pruner (drf ringbuffer)
PartOf=chirp.target
# After the recorder, which creates the directory. `drf ringbuffer` watches a
# path rather than owning it, so starting first would leave it watching
# nothing until the next inotify event.
After=chirp-rx.service
Before=chirp-detect.service chirp-ionograms.service

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/chirpsounder2

# Nothing else deletes ringbuffer data. Every example under
# examples/ringbuffer/ starts this process and stop_ringbuffer.sh already
# expects to kill it -- but no launcher started it, so /dev/shm reached 100%,
# the writer could no longer allocate, and the recording developed holes that
# surfaced downstream as "missing data - skipping" while the recorder, the
# detector and every plot carried on looking healthy.
#
# The size is also how far back a consumer can reach, which is what decides
# whether a sounding is analysable at all:
#
#     seconds of history = size / (sample_rate * 4 bytes)
#
# At 25 MS/s that is 100 MB/s, so 12000MB holds 120 s by that arithmetic. A
# sounding must begin processing within its window of history, and
# find_timings.py prints the margin for each as "N s left" -- which is the
# number to trust, because the arithmetic above does not match it: most margins
# on DOB exceed 120 s outright, so either the effective window is larger than
# size/(rate*4) suggests, or "s left" is not measured from it.
#
# **Read the tail, never a sample.** Twenty consecutive soundings on DOB gave
# min 90.6 s, median 128.4 s, none under 60 -- which reads as comfortable and
# is not. Fifty gave a minimum of **0.68 s**: one sounding that arrived within
# a second of having its samples overwritten before processing reached them.
# The distribution is long-tailed, the tail is the only part that loses data,
# and it loses it silently -- as "missing data - skipping", or as a short sweep
# that `sweep_complete` records and nothing rejects.
#
# So size a schedule from the low percentiles of the whole log, not from a
# `tail`:
#
#     grep -o '[0-9.]* s left' logs/find_timings.log \
#       | awk '{n++; if($1<30) a++; if($1<60) b++} \
#              END {printf "n=%d  <30s:%d  <60s:%d\n", n, a, b}'
#
# Raise the size on a machine with more RAM, or move the ringbuffer to an SSD
# -- it is the only lever that makes start latency stop mattering.
ExecStart=/home/ionouser/chirpsounder2/.venv38/bin/drf ringbuffer \
    -z 12000MB /dev/shm/hf25 -p 2

Restart=on-failure
RestartSec=10

[Install]
WantedBy=chirp.target
