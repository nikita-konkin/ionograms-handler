[Unit]
Description=chirpsounder2 calc_ionograms.py
PartOf=chirp.target
Requires=chirp-rx.service
After=chirp-rx.service

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/chirpsounder2

# The one process here with a deadline. It must reach a sounding's samples
# before the ringbuffer overwrites them, and the margin is not generous: over
# 165 soundings on DOB, 3% came in under 30 s and the worst was 0.50 s. Every
# other unit on this station can be late without losing anything, so this one
# is the only one given priority over them -- modestly, because starving the
# recorder to feed its consumer would be a worse trade than the one it fixes.
#
# Products must be written to a LOCAL directory. `output_dir` pointing at a
# network share puts the file server's latency inside this deadline: an SMB
# stall blocks the write while the ringbuffer keeps advancing behind it.
# chirp-archive-sync.service mirrors them to the NAS afterwards, where being
# slow is free. (Not chirp-sync.service -- that only uploads dashboard PNGs.)
Nice=-5

# Stay off physical core 0 -- see chirp-rx.service. Nice=-5 above and this line
# pull in opposite directions on purpose: this unit gets priority over its
# peers, but never over the recorder, which it cannot reach at all.
#
# 2-7 because cpu1 is cpu0's hyperthread sibling on this four-core part, so a
# rank there is on the recorder's core however the mask reads.
CPUAffinity=2-7

# **-np must equal len(sounder_timings).** In scheduled mode each rank takes
# its own transmitter -- calc_ionograms.py:452 does `st =
# conf.sounder_timings[rank]` with no guard -- so -np greater than the outer
# list length kills that rank with an IndexError while the others carry on, and
# -np smaller silently stops sounding the transmitters past the cut. Neither
# announces itself: the log looks normal because the surviving ranks are fine.
# Today that means 2, for SGO and NIC. Changing the schedule means changing
# this number in the same commit.
#
# (In serendipitous mode timings come from find_timings.py instead and any -np
# is valid, which is why this constraint only appeared when DOB switched modes
# on 2026-08-12.)
#
# **--bind-to none is not optional here either** -- see chirp-detect.service for
# the measurement. Without it Open MPI puts rank 0 on physical core 0 whatever
# CPUAffinity says, so this unit's deadline-critical rank and the recorder end
# up sharing execution units, L1 and L2.
ExecStart=/usr/bin/mpirun --bind-to none -np 2 /home/ionouser/chirpsounder2/.venv38/bin/python3 calc_ionograms.py --config /home/ionouser/chirpsounder2/my_station.ini
Restart=always
RestartSec=15

[Install]
WantedBy=chirp.target
