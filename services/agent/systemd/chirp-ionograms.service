[Unit]
Description=chirpsounder2 calc_ionograms.py
PartOf=chirp.target
Requires=chirp-rx.service
After=chirp-rx.service

[Service]
Type=simple
User=ionouser
WorkingDirectory=/home/ionouser/chirpsounder2

# The one process here with a deadline. It must reach a sounding's samples
# before the ringbuffer overwrites them, and the margin is not generous: over
# 165 soundings on DOB, 3% came in under 30 s and the worst was 0.50 s. Every
# other unit on this station can be late without losing anything, so this one
# is the only one given priority over them -- modestly, because starving the
# recorder to feed its consumer would be a worse trade than the one it fixes.
#
# Products must be written to a LOCAL directory. `output_dir` pointing at a
# network share puts the file server's latency inside this deadline: an SMB
# stall blocks the write while the ringbuffer keeps advancing behind it.
# chirp-archive-sync.service mirrors them to the NAS afterwards, where being
# slow is free. (Not chirp-sync.service -- that only uploads dashboard PNGs.)
Nice=-5

# Stay off physical core 0 -- see chirp-rx.service. Nice=-5 above and this line
# pull in opposite directions on purpose: this unit gets priority over its
# peers, but never over the recorder, which it cannot reach at all.
#
# 2-7 because cpu1 is cpu0's hyperthread sibling on this four-core part, so a
# rank there is on the recorder's core however the mask reads.
CPUAffinity=2-7

# **-np must equal len(sounder_timings).** In scheduled mode each rank takes
# its own transmitter -- calc_ionograms.py:483 does `st =
# conf.sounder_timings[rank]` with no guard -- so -np greater than the outer
# list length wedges that rank while the others carry on, and -np smaller
# silently stops sounding the transmitters past the cut. Neither announces
# itself in the obvious place: products keep appearing, because the surviving
# ranks are fine.
#
# The over-count does not even fail loudly. calc_ionograms.py wraps its main
# loop in `while True: try: ... except: print("error ... trying to restart")`,
# so the doomed rank catches its own IndexError and retries forever at 1 Hz --
# rebuilding a DigitalRFReader, i.e. rescanning the whole ringbuffer tree, on
# every pass. mpirun never tears down, systemd sees a healthy service, and the
# only symptom is a journal full of identical tracebacks and a core spent on
# nothing. That is exactly what -np 2 did here from 2026-08-12 (when the
# schedule dropped from SGO+NIC to NIC3 alone) until 2026-08-19.
#
# Today that means 4, for NIC1, NIC2, NIC3 and NIC4. Changing the schedule
# means changing this number in the same commit, and twice now that has not
# happened:
#
#   2026-08-20  the schedule went from one transmitter to three through the
#               web console while this said 1, so ranks 1 and 2 never existed
#               and NIC1 and NIC3 went unsounded for twelve hours.
#   2026-08-23  the schedule went from three to four the same way while this
#               said 3, so rank 3 never existed and NIC4 produced nothing at
#               all -- no products, no preview -- while the console listed it
#               as `sounding` beside the three that worked.
#
# Both times the console showed every transmitter as `sounding`. That
# indicator reads the ini against a clock; it cannot see how many ranks were
# started, so it will agree with the schedule no matter what mpirun did.
# The symptom to look for is not in the console's state column: it is a
# transmitter with no preview and no arrivals while its neighbours have both.
#
# The agent has a guard for this -- `control._validate` refuses a schedule
# whose rank-group count disagrees with the `-np` it text-scans out of
# `StationConfig.launcher`. It has not fired either time. In August it was
# aimed at `examples/marieluise/dombas.sh`, dead since the systemd migration,
# so the scan found no `calc_ionograms.py` line, returned None and disabled
# itself; the default now points at this unit. It stayed silent on 08-23 for
# the same reason, because that fix is in the repository and not on the
# station: `_launcher_ranks` returning None is indistinguishable from
# passing, so an undeployed guard looks exactly like a satisfied one.
#
# **Deploying the agent is therefore part of changing the schedule**, not a
# tidy-up to do later.
#
# (In serendipitous mode timings come from find_timings.py instead and any -np
# is valid, which is why this constraint only appeared when DOB switched modes
# on 2026-08-12.)
#
# **--bind-to none is not optional here either** -- see chirp-detect.service for
# the measurement. Without it Open MPI puts rank 0 on physical core 0 whatever
# CPUAffinity says, so this unit's deadline-critical rank and the recorder end
# up sharing execution units, L1 and L2.
ExecStart=/usr/bin/mpirun --bind-to none -np 4 /home/ionouser/chirpsounder2/.venv38/bin/python3 calc_ionograms.py --config /home/ionouser/chirpsounder2/my_station.ini
Restart=always
RestartSec=15

[Install]
WantedBy=chirp.target
