+    std::cout << boost::format("Channel %d LO %.6f MHz, band %.3f-%.3f MHz")
+                     % chan % (center_freq / 1e6)
+                     % ((center_freq - rate / 2.0) / 1e6)
+                     % ((center_freq + rate / 2.0) / 1e6)
+              << std::endl;
     usrp->set_rx_subdev_spec(subdev,chan);
 
