+void streaming_by_channel(size_t chan,double rate,double center_freq,std::string subdev,std::string outdir, multi_usrp::sptr usrp, uhd::time_spec_t time_last_pps, std::chrono::steady_clock::time_point end_time)
 {
     Digital_rf_write_object * data_object = NULL;
     uint64_t vector_leading_edge_index = 0;
@@ -184,7 +184,25 @@ void streaming_by_channel(size_t chan,double rate,std::string subdev,std::string
     uint64_t vector_length = 363;
 
     usrp->set_rx_rate(rate,chan);
-    usrp->set_rx_freq(20e6,chan);
+    // The LO, from the command line rather than from this line. It has to
+    // agree with `center_freq` in my_station.ini: calc_ionograms builds its
+    // downconversion mixer from that key (f0=-cf) while the samples come from
+    // here, nothing checks the two, and nothing can -- the LO is not in the
+    // Digital RF metadata. A mismatch dechirps by the difference and produces
+    // empty products with no error in any log, which happened twice on
+    // 2026-08-19. The launcher now reads the ini and passes it, so the ini is
+    // the single source of truth and the mismatch cannot be expressed.
+    usrp->set_rx_freq(center_freq,chan);
+    // Printed because its absence is what made both 2026-08-19 incidents
+    // silent: a station tuned to the wrong LO looks identical to a healthy one
+    // in every log, and the products are empty rather than wrong. Now the
+    // journal states the band on every start, and it can be compared with the
