# Получение уровня шума
python median_power_level.py -d /home/test -r 0 -z 1 -f 20 -l 512

-d директория
-r пересчёт файлов (если 0 - не пересчитывать, 1 - пересчитывать)
-z количество периодов нулей
-f коэффициент прореживания (в примере 20 - выбирать каждую двадцатую точку)
-l количество точек БПФ

 
# Получение описания всех опций
python median_power_level.py -h


# Имя выходного файла с графиками
станция_датаНачалаСеанса_времяНачалаСеанса_zКоличествоПериодовНулей_fКоэффициентПрореживания.png

пример
cyprus1_20151001_064510_z1_f20.png


