# A simulated station: the *real* agent, in a container.
#
# Nothing here is a mock. `python -m services.agent run` is exactly what runs on
# the acquisition laptop, so the push/pull loop, the JSON document, the command
# dispatch and the acknowledgement are all genuinely exercised.
#
# Two things a container cannot provide, and the agent reports both correctly
# rather than pretending:
#
#   * no systemd  -> `systemctl` is absent, so unit states come back UNKNOWN.
#     That is the tri-state working as designed; set AGENT_FAKE_SYSTEMCTL=1 to
#     demonstrate the command path anyway.
#   * no journald -> `journalctl` is absent, so log reads return an error
#     string instead of lines.
#
# Slim is fine here: the agent is urllib and stdlib. `muf` is installed only so
# the epoch-offset metric can import io_detect; it is disabled in the sim
# config because there are no par-*.h5 to solve against.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Majors, not the development machine's exact patch versions -- the same rule
# deploy/requirements-api.txt states, and for the same reason. `h5py==3.11.0`
# publishes no cp312 aarch64 wheel, so on an arm64 host pip fell back to
# building it from source and the image failed on a missing pkg-config and
# HDF5 headers. `--only-binary` makes that failure mode loud instead: if a
# resolution ever needs a compiler again, it says so at the pin rather than
# 200 lines into a build log.
RUN pip install --no-cache-dir --only-binary=:all: \
      "numpy>=1.26,<2.0" "h5py>=3.11,<4.0"

COPY muf/ /app/muf/
COPY services/ /app/services/

# `/app` is in the chown for the same reason Dockerfile.api has it there:
# COPY preserves the source mode, and a checkout whose files are 0600 -- which
# is what a synced or restrictively-umasked working copy looks like -- lands
# root-owned and unreadable to `station`. The agent then dies on
# `PermissionError: /app/services/__init__.py` before it can log anything
# useful, and the container restart-loops. Owning its own code costs nothing
# and does not make the process any more privileged.
RUN useradd --create-home --uid 10002 station \
 && mkdir -p /var/lib/station/products /etc/agent \
 && chown -R station:station /var/lib/station /etc/agent /app
USER station

CMD ["python", "-m", "services.agent", "run"]
