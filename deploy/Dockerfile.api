# The api service: FastAPI + the muf pipeline.
#
# Slim, despite the heavy scientific stack: numpy, scipy, opencv, matplotlib,
# pyarrow and scikit-learn all publish cp312 manylinux wheels, so nothing is
# compiled at install time. opencv-python-headless avoids the GUI shared
# libraries that would otherwise need an apt layer for libGL.
#
# Same base tag as Dockerfile.station on purpose: one image to pull, and a
# machine that has already built one can build the other without a registry.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg

# Requirements first so a code edit does not re-resolve the dependency tree.
#
# requirements-api.txt, not the repository's requirements.txt: that file
# documents the development machine ("verified working on Python 3.12.10 on
# Windows") and carries pytest, neither of which belongs in a server image.
# See deploy/requirements-api.txt for the rest of the reasoning.
COPY deploy/requirements-api.txt /app/
RUN pip install --no-cache-dir -r /app/requirements-api.txt

COPY muf/ /app/muf/
COPY services/ /app/services/
COPY pyproject.toml README.md /app/

# Non-root. This process is reachable from the sounding laptop; there is no
# reason for it to be able to write anything outside its own volume.
RUN useradd --create-home --uid 10001 api \
 && mkdir -p /data && chown -R api:api /data /app
USER api

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; \
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4).status==200 else 1)"

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
