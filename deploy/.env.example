# Copy to deploy/.env and edit. Never commit the real file.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- auth -------------------------------------------------------------------
# Required. An unset CONTROL_TOKEN does not open control -- it disables it.
CONTROL_TOKEN=

# Optional. Unset means reads are open, which is right for 127.0.0.1 and wrong
# the moment BIND_ADDR leaves it.
READ_TOKEN=

# --- network ----------------------------------------------------------------
# 127.0.0.1 keeps this on the work PC only. To let the sounding laptop reach
# it, set the LAN address of this machine -- not 0.0.0.0, which also exposes it
# on every other interface including any VPN.
BIND_ADDR=127.0.0.1
# Host-side port. 8000 is often already in use -- on the work server it belongs
# to tec-backend -- so the default is 8002. The container still listens on 8000.
PORT=8002

# --- archive ----------------------------------------------------------------
# Mounted read-only at /archive. Windows paths work; the drive must be shared
# in Docker Desktop (Settings -> Resources -> File sharing).
#
# **Point this at the PARENT of the folders to index, not at one of them.**
# The api container sees this one path and nothing else, so a folder outside
# it is not slow to read, it is invisible -- and the archives page refuses to
# register one rather than scheduling a scan that loads nothing forever.
# Register the subfolders on /ui/archives once the mount is up; that page
# lists what it can see here and prints this value back, so a change that did
# not take effect is visible rather than guessed at.
ARCHIVE_HOST_PATH=F:/MyData/ND/lfs

# Folders on ANOTHER disk, outside that parent. Two things are needed for each
# and neither works alone:
#
#   1. its own `volumes:` line in the compose file -- docker-compose.yml ships
#      /archive2 and /archive3 ready to use;
#   2. its container path listed in ARCHIVE_ROOTS below.
#
# Then redeploy. A container's filesystem is fixed when it starts, so a path
# cannot be added from the archives page, and there is no array form of
# ARCHIVE_HOST_PATH: a variable inside `volumes:` is substituted into ONE list
# item, so "/a:/b" would become the single broken mount "/a:/b:/archive:ro".
#
# Soundings under a non-primary root are stored with absolute container paths,
# so that database will not resolve them if read from the host. Under
# ARCHIVE_HOST_PATH they stay relative and portable, which is why the folders
# you keep should live there.
#ARCHIVE_HOST_PATH_2=D:/MoreData/lfs
#ARCHIVE_ROOTS=/archive2

# --- images (deploy/docker-compose.hub.yml only) -----------------------------
# Docker Hub account holding the images CI pushes. Not a secret.
IMAGE_NAMESPACE=nikitaikonkin
# `latest` follows the default branch. Pin to a `sha-xxxxxxx` to freeze a
# server, and to roll one back -- that is what the sha tag is for.
IMAGE_TAG=latest

# Only read when you start the optional watchtower service:
#   docker compose --profile watchtower ... up -d
# Leave it out on a host that already runs one.
WATCHTOWER_POLL_S=300
# Only for a private repository: path to a docker config.json holding the
# registry credentials. Leave as-is when the images are public.
DOCKER_CONFIG_HOST=/dev/null

# --- ingest watcher ----------------------------------------------------------
# Which folders it walks. The default is the whole of ARCHIVE_ROOT, which is
# right when the mounted folder IS an archive. It is wrong when the mount is a
# general-purpose disk: this indexer recurses without asking, so a root that
# also holds a recycle bin, a temp folder or someone's test data will have
# soundings ingested out of all three -- and a sounding read back out of
# #recycle is one that was deliberately deleted.
#
# Name the archive folders instead, space separated, by their CONTAINER paths
# (under /archive). Paths are still stored relative to ARCHIVE_ROOT, so
# narrowing this does not change what lands in the database.
#INGEST_TARGETS=/archive/ionozond_data2 /archive/ionograms
INGEST_INTERVAL_S=900
INGEST_METHODS=algo,kmeans,contour
INGEST_JOBS=0
